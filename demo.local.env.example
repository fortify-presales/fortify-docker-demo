# Local Docker Desktop environment
TRAEFIK=v3.7.13
ACME_EMAIL=admin@example.invalid

# Public hostnames resolve to the loopback interface by using the reserved
# .localhost suffix. Containers resolve the same names through Traefik aliases
# in docker-compose.local.yml.
LIM_HOSTNAME=lim.ftfydemo.localhost
SSC_HOSTNAME=ssc.ftfydemo.localhost
SCANCENTRAL_SAST_CONTROLLER_HOSTNAME=scancentral-sast-controller.ftfydemo.localhost
SCANCENTRAL_DAST_API_HOSTNAME=scancentral-dast-api.ftfydemo.localhost
SCANCENTRAL_DAST_FORTIFYCONNECT_HOSTNAME=localhost

# LIM
FORTIFY_DOCKER__LIM=26.2.ubi.9
LIM_USERNAME=limadm
LIM_PASSWORD=F0rtifyPassword!
LIM_POOL_NAME=Default
LIM_POOL_PASSWORD=F0rtifyPassword!

# Software Security Center
FORTIFY_DOCKER__SSC_WEBAPP=26.2.2
SSC_DAST_USERNAME=admin
SSC_DAST_PASSWORD=F0rtifyPassword!

# SSC MySQL
FORTIFY_DOCKER__MYSQL=8.4-oracle
MYSQL_ROOT_PASSWORD=rootpassw0rd
MYSQL_DATABASE=sscdemodb
MYSQL_USER=sscdemodbuser
MYSQL_PASSWORD=sscdemodbpassw0rd

# ScanCentral SAST
SCANCENTRAL_SAST_CONTROLLER_VERSION=26.2.1
SCANCENTRAL_SAST_SENSOR_VERSION=26.2.3

# Shared PostgreSQL
POSTGRES_VERSION=17.5

# Sonatype
NEXUS_REPO_VERSION=3.96.4-ubi
NEXUS_IQ_SERVER_VERSION=1.207.1
NEXUS_REPO_HOSTNAME=repo.ftfydemo.localhost
NEXUS_IQ_HOSTNAME=lifecycle.ftfydemo.localhost
NEXUS_IQ_INTEGRATION_HOSTNAME=lifecycle2ssc.ftfydemo.localhost
NEXUS_IQ_USERNAME=admin
SONATYPE_POLL_INTERVAL_MINUTES=15
SONATYPE_WEBHOOK_ALLOWED_CIDRS=127.0.0.1/32

# ScanCentral DAST
SCDAST_DOCKER_VERSION=26.2.ubi.9
SCDAST_DATABASE_NAME=scdast
SCDAST_DATABASE_USER=scdast
SCANCENTRAL_DAST_FORTIFYCONNECT_PORT=2022