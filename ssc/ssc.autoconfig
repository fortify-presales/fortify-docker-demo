
appProperties:
  host.url: "http://ssc:8080/ssc"   # Internal URL; NGINX will expose SSL externally
  host.validation: false
  searchIndex.location: "/opt/fortify/ssc/index"

datasourceProperties:
  jdbc.url: "jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DB}?sessionVariables=collation_connection=latin1_general_cs&rewriteBatchedStatements=true"
  db.username: "${MYSQL_USER}"
  db.password: "${MYSQL_PASS}"

dbMigrationProperties:
  migration.enabled: true

license:
  path: "/opt/fortify/ssc/license/fortify-license.txt"

seeds:
  - "/opt/fortify/ssc/bundles/Fortify_Process_Seed_Bundle.zip"
  - "/opt/fortify/ssc/bundles/Fortify_Report_Seed_Bundle.zip"

