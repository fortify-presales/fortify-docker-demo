# Uncomment to change path to your locally stored Fortify license file.
# Path is relative to the directory where docker-compose.yaml is located.
# Defaults to 'fortify.license' in the same directory as docker-compose.yaml.
#SSC_LICENSEPATH='fortify.license'

# Uncomment to change SSC server path prefix (SSC context), e.g., '/ssc'.
# Must include leading slash. Defaults to root context.
#SSC_URL_PREFIX='/'

# Uncomment to change hostname for SSC. Defaults to localhost.
SSC_HOSTNAME='ssc.onfortify.com'

# Uncomment to change external HTTPS port for SSC. Defaults to 443.
SSC_HTTPS_PORT='8443'

# Uncomment to change external HTTP port for SSC.
# Defaults to 0 (bind to some free port).
SSC_HTTP_PORT='8080'

# Uncomment to change SSC demo image. Defaults to 'ssc-demo-webapp'.
# Change it to 'ssc-webapp' to avoid seeding SSC Demo Seed bundle.
SSC_IMAGE='ssc-webapp'

# Uncomment to change repository prefix for SSC container image.
# Must include trailing slash. Defaults to Docker Hub fortifydocker organization.
#SSC_REPOSITORY_PREFIX='docker.io/fortifydocker/'

# Uncomment to change repository prefix for container MySQL image (mysql).
# Must include trailing slash. Defaults to Docker Hub official image library.
#MYSQL_REPOSITORY_PREFIX='docker.io/library/'
