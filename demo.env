
# Traefik
TRAEFIK=v3.7.13
# Required for Let's Encrypt certificate expiry notices.
ACME_EMAIL=admin@onfortify.com

# LIM
FORTIFY_DOCKER__LIM=26.2.ubi.9
LIM_USERNAME=limadm
LIM_PASSWORD=F0rtifyPassword!

# Software Security Center
FORTIFY_DOCKER__SSC_WEBAPP=26.2.2
SSC_HOSTNAME=ssc.onfortify.com

# SSC MySQL
FORTIFY_DOCKER__MYSQL=8.4-oracle
MYSQL_ROOT_PASSWORD=rootpassw0rd
MYSQL_DATABASE=sscdemodb
MYSQL_USER=sscdemodbuser
MYSQL_PASSWORD=sscdemodbpassw0rd

# ScanCentral SAST
SCANCENTRAL_SAST_CONTROLLER_VERSION=26.2.1
SCANCENTRAL_SAST_SENSOR_VERSION=26.3.0
SCANCENTRAL_SAST_CONTROLLER_HOSTNAME=scancentral-sast-controller.onfortify.com
