
# Dockerhub image versions for Fortify Docker demo environment
# Update these values to change the versions used in the demo environment
TRAEFIK=v3.7.13
FORTIFY_DOCKER__LIM=26.2.ubi.9
FORTIFY_DOCKER__MYSQL=8.4-oracle

# Contact email Let's Encrypt uses for certificate expiry notices (required, must be a real deliverable address)
ACME_EMAIL=admin@onfortify.com
FORTIFY_DOCKER__SSC_WEBAPP=26.2.2

# LIM credentials (not secret - used for local demo only)
LIM_USERNAME=limadm
LIM_PASSWORD=F0rtifyPassword!

# MySQL credentials (not secret - used for local demo only)
MYSQL_ROOT_PASSWORD=rootpassw0rd
MYSQL_DATABASE=sscdemodb
MYSQL_USER=sscdemodbuser
MYSQL_PASSWORD=sscdemodbpassw0rd

# SSC credentials (not secret - used for local demo only)
SSC_USERNAME=sscadmin
SSC_PASSWORD=F0rtifyPassword!

# MySQL demo configuration

#SCANCENTRAL_SAST_CONTROLLER_VERSION=24.2
#SCANCENTRAL_SAST_SENSOR_VERSION=24.2
#NEXUS_REPO_VERSION=3.71.0
#NEXUS_IQ_SERVER_VERSION=1.180.0
#JENKINS_VERSION=lts-jdk17
